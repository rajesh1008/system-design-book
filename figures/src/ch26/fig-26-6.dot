// Figure 26.6  The gateway's checks, in order
// Reading order: top to bottom. A call passes authentication, the
// registry and its description hash, the caller's scope, the code-mode
// rule, the argument schema, the permission for effects and the rate
// limit, then is forwarded with its output capped. Any failure is a
// structured refusal. Every outcome writes one trail line. From
// gateway.core.Gateway.call.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.18;
  call [label="Tool call\ncaller, server, tool", class="model"];
  auth [label="Authenticated", class="policy gate"];
  reg [label="Registered, approved,\nhash matches", class="policy gate"];
  scope [label="In caller's grant;\ncode mode reads only", class="policy gate"];
  schema [label="Arguments valid", class="policy gate"];
  perm [label="Effect: permission\nfor these arguments", class="policy gate"];
  rate [label="Within rate", class="policy gate"];
  fwd [label="Forward,\ncap output", class="ops"];
  refuse [label="Refusal\nreason, field, fix", class="fail"];
  trail [label="Trail", class="knowledge store note"];
  call -> auth -> reg -> scope -> schema -> perm -> rate [class="data"];
  rate -> fwd [class="emphasis"];
  scope -> refuse [class="fail"];
  fwd -> trail [class="trail"];
  refuse -> trail [class="trail"];
  { rank=same; schema; refuse; }
}
