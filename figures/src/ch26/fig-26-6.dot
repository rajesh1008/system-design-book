// Figure 26.6  Registry review and the description hash
// Reading order: top to bottom, then the serving check at the
// bottom. A submission is screened; a person reviews the findings; an
// approval records a hash of name, description and schema. At call
// time the gateway hashes what the server serves; a mismatch is a
// refusal and a resubmission. From gateway.registry.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.25;
  sub [label="Submission", class="org"];
  scr [label="Screen", class="policy gate"];
  rev [label="Reviewer\nOwen Fletcher", class="org human"];
  ent [label="Approved,\nhash kept", class="knowledge store"];
  rej [label="Rejected", class="fail"];
  served [label="Served text", class="ops"];
  cmp [label="Hash match?", class="policy gate"];
  sub -> scr -> rev [class="data"];
  rev -> ent [class="emphasis", label=" approve"];
  rev -> rej [class="fail", label=" reject"];
  served -> cmp [class="data"];
  ent -> cmp [class="control"];
  cmp -> rej [class="fail", label=" changed"];
  { rank=same; ent; rej; }
}
