// Figure 23.1  Every input crosses the edge as data
// Reading order: left to right. Six intake paths feed one edge; the
// edge tags every input untrusted, extracts contract fields with
// confidence and provenance, and quarantines the rest. Only the
// envelope reaches the context assembler; only the gateway can act.
// From inputs.demo --part edge (6 of 6 tagged).
digraph edge {
#include "book.gv"
  rankdir=LR; nodesep=0.2; ranksep=0.45;
  src [label="Six intake paths\ndocs, OCR, email,\nchat upload,\nvoicemail, notices", class="knowledge"];
  edge [label="The edge\ntag untrusted\nextract fields\nrecord provenance", class="policy"];
  q [label="Quarantine\nraw text, hidden\nlayers, signals", class="knowledge"];
  ctx [label="Context assembler\nenvelopes only", class="model"];
  gw [label="Effect gateway\nrecords decide", class="policy"];
  act [label="Refund, rebook,\nchange", class="ops"];
  src -> edge [class="data"];
  edge -> q [class="data", label=" everything else"];
  edge -> ctx [class="emphasis", label=" fields"];
  ctx -> gw [class="data", label=" proposal"];
  gw -> act [class="data"];
  { rank=same; q; ctx; }
}
