// Figure 23.2  Every input crosses the edge as data
// Reading order: top to bottom. Six intake paths feed one edge; the
// edge tags every input untrusted, extracts contract fields with
// confidence and provenance, and quarantines the rest. Only the
// envelope reaches the context assembler; only the gateway can act.
// From inputs.demo --part edge (6 of 6 tagged).
digraph inputedge {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.3;
  src [label="Six intake paths", class="knowledge"];
  gate [label="The edge\ntag untrusted\nextract fields", class="policy"];
  q [label="Quarantine\nraw text,\nhidden layers", class="knowledge"];
  ctx [label="Context\nenvelopes only", class="model"];
  gw [label="Effect gateway\nrecords decide", class="policy"];
  act [label="Refund, rebook", class="ops"];
  src -> gate [class="data"];
  gate -> q [class="data"];
  gate -> ctx [class="emphasis", label=" fields"];
  ctx -> gw [class="data", label=" proposal"];
  gw -> act [class="data"];
  { rank=same; q; ctx; }
}
