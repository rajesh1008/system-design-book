// Figure 33.3  Untrusted input, private data, outbound channel
// Reading order: top to bottom. Three legs meet in one session; the
// gateway keeps the outbound leg closed and puts every state change
// through policy. From threats.trifecta.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.35; ranksep=0.35;
  a [label="A  Untrusted input\nchat, tool results", class="fail"];
  b [label="B  Private data\nbooking_read, doc_intake", class="ops"];
  s [label="One session\none itinerary", class="model"];
  gw [label="Gateway", class="policy gate"];
  out [label="C  Outbound\nclosed", class="policy"];
  chg [label="C  State change\nthrough policy", class="policy gate"];
  a -> s [class="emphasis"];
  b -> s [class="data"];
  s -> gw [class="data"];
  gw -> out [class="control", label=" egress list"];
  gw -> chg [class="control", label=" permit"];
}
