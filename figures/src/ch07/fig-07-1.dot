// Figure 7.1  An effect is not a call
// Reading order: left box without a key, right box with the effect
// ledger. In each box the calls are on the left and the hotel's own
// record is on the right. Two calls make two effects unless something
// can tell that the second call is the first one again.
digraph effect_not_call {
#include "book.gv"
  rankdir=LR; nodesep=0.25;
  subgraph cluster_a { label="Retry with no key"; class="plane-ops";
    a1 [label="Attempt 1\ntimeout at 8.0 s", class="ops"];
    a2 [label="Attempt 2\nok", class="ops"];
    r1 [label="Room 1\ncanceled", class="evidence store"];
    r2 [label="Room 2\ncanceled", class="fail store"];
    a1 -> r1 [class="data"];
    a2 -> r2 [class="fail"];
  }
  subgraph cluster_b { label="Effect ledger, no retry"; class="plane-evidence";
    b1 [label="Attempt 1\ntimeout at 8.0 s", class="ops"];
    b2 [label="Unknown\nto a person", class="human"];
    r3 [label="Room 1\ncanceled", class="evidence store"];
    b1 -> r3 [class="data"];
    b1 -> b2 [class="control"];
  }
}
