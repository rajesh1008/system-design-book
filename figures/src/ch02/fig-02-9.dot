// Figure 2.9  Gap 4: execution to verified outcome
// Reading order: top to bottom. The record that closes the gap sits on
// the main path; the failure when it is missing branches below.
digraph gap4 {
#include "book.gv"
  rankdir=TB; nodesep=0.45; ranksep=0.35;
  a [label="Execution", class="ops"];
  r [label="Independent read", class="evidence store"];
  b [label="Verified outcome", class="verified gate"];
  x [label="Self-report", class="fail"];
  a -> r [class="control"];
  r -> b [class="emphasis"];
  a -> x [label=" No record", class="fail"];
  { rank=same; r; x; }
}
