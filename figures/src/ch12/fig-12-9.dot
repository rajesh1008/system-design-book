// Figure 12.9  Degraded modes ladder
// Reading order: top to bottom, from full service to the agent off. Each
// rung names its trigger and what keeps working; the rung is computed
// from the breaker, the kill switch, and the planes' health.
digraph ladder {
#include "book.gv"
  rankdir=TB; nodesep=0.4; ranksep=0.32;
  full [label="Full\npropose, permit, act, verify", class="verified"];
  prop [label="Propose-only\npermissions granted, effects held with keys", class="ops"];
  ans [label="Answer-only\nanswers and status, no proposals", class="policy"];
  ppl [label="People-only\nevery contact to a person", class="org human"];
  full -> prop [label=" breaker open, or kill switch tier 1 or 2", class="control"];
  prop -> ans [label=" control plane down, or facts stale", class="control"];
  ans -> ppl [label=" kill switch tier 3", class="control"];
}
