// Figure 20.5  The query guard, in order
// Reading order: top to bottom. Each check either passes the query
// down or refuses it with a named reason; only a query that clears
// all four runs, read-only, and every decision writes a trail line.
digraph guard {
#include "book.gv"
  rankdir=TB; nodesep=0.35; ranksep=0.22;
  q [label="Query + grant", class="knowledge"];
  r [label="1 Restrict:\nin the layer?", class="policy gate"];
  e [label="2 Estimate:\nbytes, $, seconds", class="policy gate"];
  l [label="3 Limits:\nwindow, $1, 60 s", class="policy gate"];
  n [label="4 Entitlement:\nrole, desk, column", class="policy gate"];
  run [label="5 Run read-only,\n1,000 rows", class="ops"];
  ref [label="Refused", class="fail"];
  t [label="Trail", class="evidence store"];
  {rank=same; e; ref;}
  q -> r [class="control"];
  r -> e [class="control"];
  e -> l [class="control"];
  l -> n [class="control"];
  n -> run [class="emphasis"];
  r -> ref [class="fail", label="not in layer"];
  e -> ref [class="fail", label="no estimate"];
  l -> ref [class="fail", label="window, cost"];
  n -> ref [class="fail", label="entitlement"];
  run -> t [class="trail"];
  ref -> t [class="trail"];
}
