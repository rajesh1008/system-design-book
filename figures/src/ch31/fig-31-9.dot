// Figure 31.9  The three-tier kill switch (signature figure S8)
// Reading order: top to bottom. The operator writes one flag; every
// gateway replica reads it. Tier one holds one tool, tier two holds all
// effects at the gateway, tier three turns the agent off and revokes
// its run tokens. The drill observes the safe state. From policy.kill.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.3;
  op [label="Ben Carter\npulls a tier", class="org human"];
  flag [label="Flag\nkill/servicing", class="policy store"];
  gw [label="Gateway replicas\nread every 5 s", class="ops"];
  t1 [label="Tier one\none tool held", class="policy"];
  t2 [label="Tier two\nall effects held", class="policy"];
  t3 [label="Tier three\nagent off, tokens revoked", class="policy"];
  obs [label="Drill observes\nsafe state", class="verified"];
  op -> flag [class="control"];
  flag -> gw [class="emphasis"];
  gw -> t1 [class="control"];
  gw -> t2 [class="control"];
  gw -> t3 [class="control"];
  t1 -> obs [class="trail"];
  t2 -> obs [class="trail"];
  t3 -> obs [class="trail"];
}
