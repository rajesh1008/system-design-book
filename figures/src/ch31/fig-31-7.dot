// Figure 31.7  Temporal and sequence policies
// Reading order: top to bottom. A proposed effect is checked against
// what already happened in the window, then against quiet periods,
// then against what the session has read. From policy.temporal.
digraph flow {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.28;
  prop [label="Proposed effect", class="model"];
  rep [label="Same key in window?\nrefund once per 24 h", class="policy"];
  qui [label="Quiet period?\nno voucher after refund", class="policy"];
  ses [label="Session read upload?\nescalate money", class="policy"];
  ok [label="Other rules", class="policy gate"];
  desk [label="Route to desk", class="org human"];
  prop -> rep [class="data"];
  rep -> qui [class="data", label=" no"];
  qui -> ses [class="data", label=" no"];
  ses -> ok [class="emphasis", label=" no"];
  rep -> desk [class="control", label=" yes"];
  qui -> desk [class="control", label=" yes"];
  ses -> desk [class="control", label=" yes"];
}
