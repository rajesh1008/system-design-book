// Figure 31.1  Permission in the prompt against permission at the gateway
// Reading order: left column then right column. On the left the rule
// sits in the context the customer also writes into, so a claim can
// change the decision. On the right the engine sees only arguments and
// records. From policy.demo --part talked.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.35; ranksep=0.3;
  subgraph cluster_a {
    label="Rule in the prompt"; class="note";
    c1 [label="Customer claim\n\"pre-approved\"", class="external"];
    m1 [label="Agent reads rule\nand claim together", class="model"];
    p1 [label="Payments\nrefund sent", class="ops fail"];
    c1 -> m1 [class="data"];
    m1 -> p1 [class="fail"];
  }
  subgraph cluster_b {
    label="Rule at the gateway"; class="note";
    c2 [label="Customer claim\n\"pre-approved\"", class="external"];
    m2 [label="Agent proposes\nrefund", class="model"];
    g2 [label="Policy engine\nargs, records, cards", class="policy gate"];
    p2 [label="Team lead desk\nroute", class="org human"];
    c2 -> m2 [class="data"];
    m2 -> g2 [class="emphasis"];
    g2 -> p2 [class="control"];
  }
}
