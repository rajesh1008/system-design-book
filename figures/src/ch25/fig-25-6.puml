@startuml
' Figure 25.6  The manifest
' Reading order: the manifest at the top names the loop shape and owns
' four sections, each a part of the harness, with values from
' Lakeshore's servicing 1.0.0. The hash covers all of it, tool
' descriptions included.
!include plantuml-theme.puml
class "Manifest" as M <<ops>> {
  +name, version, owner
  +loop shape
  +hash
}
class "Tool, 14 of them" as T <<ops>> {
  +name, version
  +description
}
class "Context policy" as C <<evidence>> {
  +48,000 tokens
  +pinned fields
}
class "Stop Condition, 4" as S <<policy>> {
  +id, check
}
class "Budgets" as B <<policy>> {
  +24 steps, $1.00
}
M *-- T
M *-- C
M *--- S
M *--- B
T -[hidden]right- C
S -[hidden]right- B
@enduml
