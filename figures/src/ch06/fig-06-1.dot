// Figure 6.1  The reference architecture: four planes (signature S4)
// Reading order: top to bottom. Knowledge feeds the agent loop; the loop
// proposes to the control plane; the one emphasized path is the
// permission that reaches the gateway; the gateway is the only way to the
// systems of record; the trail records both planes and its verifier
// reads the systems of record, not the actor's report.
digraph planes {
#include "book.gv"
  rankdir=TB; nodesep=0.5; ranksep=0.45; newrank=true;
  subgraph cluster_k { label="Knowledge plane"; class="plane-knowledge";
    k [label="Retrieval\nand memory", class="knowledge store"];
  }
  subgraph cluster_a { label="Action plane"; class="plane-ops";
    loop [label="Agent loop", class="model"];
    gw [label="Gateway", class="ops gate"];
  }
  subgraph cluster_c { label="Control plane"; class="plane-policy";
    pol [label="Policy and\napproval", class="policy gate"];
    ids [label="Identity and\nbudgets", class="policy"];
  }
  subgraph cluster_t { label="Trail"; class="plane-evidence";
    tr [label="Trail", class="evidence store"];
    ver [label="Verifier", class="verified gate"];
  }
  sor [label="Systems\nof record", class="ops external store"];
  k -> loop [label=" context", class="data"];
  loop -> pol [label=" proposal", class="control"];
  pol -> gw [label=" permission", class="emphasis"];
  loop -> gw [class="control"];
  ids -> pol [class="data", arrowhead=none];
  gw -> sor [class="control"];
  gw -> tr [class="trail"];
  pol -> tr [class="trail"];
  sor -> ver [label=" reads", class="data", dir=back, constraint=false];
  ver -> tr [class="trail"];
  { rank=same; loop; pol; }
  { rank=same; gw; ids; }
  { rank=same; sor; ver; tr; }
  loop -> pol [style=invis];
  sor -> ver -> tr [style=invis];
}
