@startuml
' Figure 6.3  Contracts at each plane boundary
' Reading order: top to bottom. Each box is what crosses one boundary;
' the label on each arrow names its contract, C1 to C6.
!include plantuml-theme.puml
hide empty methods
hide circle
class "Context packet" as CP <<knowledge>> {
  facts with source, as_of
}
class "Proposal" as PR <<ops>> {
  task, itinerary, amount
}
class "Decision" as DE <<policy>> {
  verdict, reason, level
}
class "Permission" as PE <<policy>> {
  id, grantor, cap, key
}
class "Effect record" as EF <<evidence>> {
  permission, key, reference
}
class "Trail line" as TL <<evidence>> {
  seq, prev hash
}
class "Verification" as VE <<evidence>> {
  verifier, matches, ok
}
CP -down-> PR : C1
PR -down-> DE : C2
DE -right-> PE
PE -down-> EF : C3
DE -down-> TL : C5
EF -left-> TL : C4
TL -down-> VE : C6
@enduml
