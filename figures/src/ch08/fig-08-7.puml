@startuml
' Figure 8.7  Dead-letter flow
' Reading order: top to bottom. A transient failure is retried up to
' a limit; a poison message is quarantined with its owner, only its
' itinerary is parked, and replay after a fix runs in order.
!include plantuml-theme.puml
start
:Receive;
if (Applies?) then (yes)
  :Inbox records it;
else (no)
  if (Transient?) then (yes)
    :Retry, up to 5;
  else (poison)
    :Quarantine,
    owner named; <<$F_FAIL>>
    :Park the
    itinerary;
    :Fix, replay
    in order;
  endif
endif
stop
@enduml
