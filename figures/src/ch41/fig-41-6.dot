// Figure 41.6  Operating rhythm
// Reading order: the week runs top to bottom, Monday to Thursday; each
// forum has one owner (the decisions each reviews are in the text). The monthly
// forums sit to the right and feed card day at the end of the month.
// Times and decisions are in the text. From org.rhythm.
digraph rhythm {
#include "book.gv"
  rankdir=TB; nodesep=0.25; ranksep=0.28;
  mon1 [label="Mon on-call handover\nBen Carter", class="ops"];
  mon2 [label="Mon platform review\nDaniel Price", class="org"];
  tue [label="Tue access review\nOwen Fletcher", class="org"];
  wed [label="Wed gate review\nHannah Clarke", class="org"];
  thu [label="Thu rules review\nMarcus Bell", class="org"];
  drill [label="Kill-switch drill\nBen Carter", class="ops"];
  bill [label="Monthly bill review\nPriya Natarajan", class="org"];
  risk [label="Monthly risk review\nRachel Morgan", class="org"];
  card [label="Card day\nDaniel Price", class="org gate"];
  mon1 -> mon2 -> tue -> wed -> thu [class="control"];
  thu -> drill [class="data"];
  thu -> card [class="async"];
  bill -> card [class="data"];
  risk -> card [class="data"];
  card -> mon2 [class="emphasis", label="questions"];
  {rank=same; mon1; bill;}
  {rank=same; tue; risk;}
}
