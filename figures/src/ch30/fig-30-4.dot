// Figure 30.4  Progressive disclosure of skills
// Reading order: top to bottom. Every skill's name and description
// are in context from the start; a body loads when the case needs
// the skill; a linked file loads when the body points to it. Token
// counts are estimates from runtimes.skills for one fare-rules case.
digraph hld {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.28;
  l1 [label="Level 1: names and\ndescriptions, 108 tokens", class="knowledge"];
  l2 [label="Level 2: fare-rules\nbody, 139 tokens", class="knowledge"];
  l3 [label="Level 3: carriers.md\n143 tokens", class="knowledge store"];
  ctx [label="Context: 390 tokens\nnot 596", class="model"];
  l1 -> l2 [class="data", label=" case needs it"];
  l2 -> l3 [class="data", label=" body links it"];
  l3 -> ctx [class="emphasis"];
}
