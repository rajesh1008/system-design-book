// Figure 1.2  Answering versus acting, side by side
// Reading order: left column answers, top to bottom; right column acts,
// top to bottom. On the left a person reads the words before anything
// happens. On the right the world changes first.
digraph answer_act {
#include "book.gv"
  rankdir=TB;
  subgraph cluster_a { label="Answering"; class="plane-model";
    a1 [label="Question", class="human"];
    a2 [label="Model", class="model"];
    a3 [label="Words on a screen", class="note"];
    a4 [label="Person decides", class="human"];
    a1 -> a2 [class="control"]; a2 -> a3 [class="data"];
    a3 -> a4 [label=" read", class="data"];
  }
  subgraph cluster_b { label="Acting"; class="plane-ops";
    b1 [label="Request", class="human"];
    b2 [label="Model", class="model"];
    b3 [label="Tool call", class="ops"];
    b4 [label="World changed", class="fail store"];
    b1 -> b2 [class="control"]; b2 -> b3 [class="control"];
    b3 -> b4 [label=" effect", class="fail"];
  }
}
