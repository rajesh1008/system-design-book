// Figure 5.4  Diagram grammar: shapes, edges, boundaries
// Reading order: top to bottom, one lane per plane; the boundary
// separates what Lakeshore runs from what it does not.
digraph grammar {
#include "book.gv"
  rankdir=TB;
  newrank=true;
  subgraph cluster_boundary { label="Boundary: what Lakeshore runs"; class="plane-org";
  subgraph cluster_action { label="Action plane"; class="plane-model";
    loop [label="Loop\n(harness)", class="model"];
    model [label="Model call", class="model"];
    tool [label="Tool or\nservice", class="ops"];
  }
  subgraph cluster_control { label="Control plane"; class="plane-policy";
    gate [label="Gate", class="policy gate"];
    person [label="Person", class="org human"];
  }
  subgraph cluster_knowledge { label="Knowledge plane"; class="plane-knowledge";
    kstore [label="Store\nof record", class="knowledge store"];
  }
  subgraph cluster_trail { label="Trail plane"; class="plane-evidence";
    verifier [label="Verifier\n(did not act)", class="verified"];
    trail [label="Trail", class="evidence store"];
  }
  }
  external [label="External\n(beyond the boundary)", class="ops external"];
  kstore -> loop [label="data", class="data"];
  loop -> model [label="data", class="data"];
  loop -> gate [label="control", class="control"];
  gate -> person [label="async", class="async"];
  gate -> tool [label="control", class="control"];
  tool -> external [label="effect", class="emphasis"];
  gate -> trail [label="trail", class="trail"];
  external -> verifier [label="data", class="data"];
  verifier -> trail [label="trail", class="trail"];
}
