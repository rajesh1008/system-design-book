// Figure 17.4  Verifiable rewards need the harness
// Reading order: left to right, then back. The policy acts in the
// carrier sandbox through the same tools and gateway as production.
// The reward comes from the harness reading the system of record, not
// from the model's own report, and the trail keeps every episode.
digraph rlvr {
#include "book.gv"
  rankdir=TB; nodesep=0.4; ranksep=0.3;
  pol [label="Policy\n(model)", class="model"];
  gw [label="Tools and\ngateway", class="ops gate"];
  sb [label="Carrier\nsandbox", class="org external"];
  sor [label="System of\nrecord", class="evidence store"];
  h [label="Harness: exactly\none booking,\nin policy", class="verified gate"];
  tr [label="Trail", class="ops store"];
  pol -> gw [class="control"];
  gw -> sb [class="control"];
  sb -> sor [class="data"];
  sor -> h [class="data"];
  h -> pol [class="emphasis", label="reward"];
  h -> tr [class="trail"];
  pol -> h [class="fail", style=dashed, label="\"done\" is\nnot read"];
}
