// Figure 17.8  Reward hacking: the policy learns what the grader pays
// Reading order: top to bottom, three rows. Each grader on the left
// pays for something; the middle column is the action the policy
// learned after 3,000 episodes; the right column is the verified
// success the harness measured. Only the harness grader produces work.
digraph hack {
#include "book.gv"
  rankdir=TB; nodesep=0.15; ranksep=0.6;
  g1 [label="Pays for\n\"done\"", class="fail"];
  g2 [label="Pays for\nany booking", class="policy"];
  g3 [label="Pays for one,\nin policy", class="verified gate"];
  a1 [label="Claims\nwithout acting", class="fail"];
  a2 [label="Books\ntwice", class="policy"];
  a3 [label="Acts\nonce", class="verified"];
  r1 [label="Verified 0%", class="fail note"];
  r2 [label="Verified 15%", class="policy note"];
  r3 [label="Verified 88%", class="verified note"];
  g1 -> a1 [class="fail"]; a1 -> r1 [class="fail"];
  g2 -> a2 [class="policy"]; a2 -> r2 [class="policy"];
  g3 -> a3 [class="emphasis"]; a3 -> r3 [class="emphasis"];
}
