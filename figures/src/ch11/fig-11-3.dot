// Figure 11.3  The shared scratch directory
// Reading order: top to bottom. Two worker sessions on one host mounted
// the same scratch path. Each case uploaded a scan there, and the tool
// read "the newest upload", which was sometimes the other worker's case.
digraph scratch {
#include "book.gv"
  rankdir=TB; nodesep=0.5; ranksep=0.4;
  a [label="Worker A\ncase for LTG-A", class="ops"];
  b [label="Worker B\ncase for LTG-B", class="ops"];
  d [label="/scratch/doc-intake\nuploads/", class="ops store"];
  t [label="Tool reads\nnewest upload", class="ops code"];
  x [label="Proposal for A\nwith B's passport", class="fail"];
  a -> d [label=" scan A", class="data"];
  b -> d [label=" scan B", class="data"];
  d -> t [class="data"];
  t -> x [label=" cross-read", class="fail"];
}
