// Figure 11.5  Tenant separation in retrieval and memory
// Reading order: top to bottom. The tenant comes from the session token,
// never from the model's arguments. The retriever filters inside the
// index before ranking; shared policy text has no tenant, and each
// customer's bookings and memory sit in their own partition.
digraph tenants {
#include "book.gv"
  rankdir=TB; nodesep=0.4; ranksep=0.45;
  tok [label="Session token\ntenant = traveler", class="policy gate"];
  q [label="Model's query", class="model"];
  r [label="Retriever\nfilter, then rank", class="knowledge"];
  subgraph cluster_i { label="Index"; class="plane-knowledge";
    pub [label="Policy text\nno tenant", class="knowledge store"];
    mine [label="This traveler's\nbookings, memory", class="knowledge store"];
    other [label="Other travelers", class="knowledge store"];
  }
  tok -> r [label=" tenant", class="policy"];
  q -> r [label=" text only", class="data"];
  r -> pub [class="data"];
  r -> mine [class="emphasis"];
  r -> other [label=" refused", class="fail", style=dashed];
  { rank=same; tok; q; }
}
