// Figure 13.7  Contract tests in the release path
// Reading order: left to right. A change to the prompt, the pin or the
// contract runs the golden suite live; a pass becomes the new baseline
// and ships; a fail blocks. The nightly run compares against the same
// baseline without any change from us.
digraph release_path {
#include "book.gv"
  rankdir=TB; nodesep=0.3; ranksep=0.3;
  change [label="Change\nprompt, pin, contract", class="model"];
  nightly [label="Nightly run\n02:00 CT", class="model"];
  suite [label="Golden suite\n42 cases, live", class="model gate"];
  base [label="Baseline\necho, passes, shapes", class="verified store"];
  ship [label="Ship new version", class="verified"];
  block [label="Block and alert", class="fail"];
  change -> suite [class="data"];
  nightly -> suite [class="data"];
  suite -> base [class="verified", label="pass"];
  base -> ship [class="verified"];
  suite -> block [class="fail", label="fail or drift"];
  base -> suite [class="trail", label="compare"];
}
