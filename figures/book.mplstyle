# Generated by 05-build/gen_theme.py from 03-figures/palette.json. Do not edit by hand.
# Book plot style. Use through 03-figures/figlib.py (it registers the vendored fonts first).
figure.figsize       : 4.5, 3.4
figure.dpi           : 150
figure.facecolor     : white
figure.edgecolor     : white
savefig.facecolor    : white
savefig.edgecolor    : white
savefig.transparent  : False
savefig.bbox         : tight
savefig.pad_inches   : 0.08
svg.fonttype         : path
pdf.fonttype         : 42
font.family          : sans-serif
font.sans-serif      : Source Sans 3, Noto Sans, DejaVu Sans
font.monospace       : JetBrains Mono NL, Noto Sans Mono, DejaVu Sans Mono
font.size            : 11
text.color           : 1A1A1A
axes.titlesize       : 12
axes.titleweight     : semibold
axes.titlelocation   : left
axes.labelsize       : 11
axes.labelcolor      : 1A1A1A
axes.edgecolor       : 4B5563
axes.linewidth       : 0.75
axes.facecolor       : white
axes.spines.top      : False
axes.spines.right    : False
axes.grid            : False
axes.axisbelow       : True
axes.prop_cycle      : cycler('color', ['1F2A44', '0F766E', 'B7791F', '4F6D9A', '6B7280', '7B4B94', '2F7A3E', 'C0392B']) + cycler('linestyle', ['-', '--', '-.', ':', '-', '--', '-.', ':']) + cycler('marker', ['o', 's', '^', 'D', 'v', 'P', 'X', '*'])
grid.color           : D9DCE1
grid.linewidth       : 0.6
grid.linestyle       : -
xtick.labelsize      : 9.5
ytick.labelsize      : 9.5
xtick.color          : 1A1A1A
ytick.color          : 1A1A1A
xtick.major.width    : 0.75
ytick.major.width    : 0.75
lines.linewidth      : 1.5
lines.markersize     : 5
patch.linewidth      : 0.75
patch.edgecolor      : 1A1A1A
hatch.color          : 1A1A1A
hatch.linewidth      : 0.6
legend.frameon       : False
legend.fontsize      : 9.5
image.cmap           : cividis
